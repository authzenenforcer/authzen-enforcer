<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>io.github.authzenenforcer</groupId>
        <artifactId>authzen-enforcer-parent</artifactId>
        <version>0.3.0-SNAPSHOT</version>
    </parent>

    <artifactId>authzen-enforcer-opentelemetry</artifactId>
    <packaging>jar</packaging>

    <name>AuthZEN Enforcer OpenTelemetry</name>
    <description>OpenTelemetry tracing for the AuthZEN Enforcer client: call and HTTP exchange spans, with W3C trace context propagation to the PDP.</description>

    <dependencies>
        <dependency>
            <groupId>io.github.authzenenforcer</groupId>
            <artifactId>authzen-enforcer-core</artifactId>
            <version>${project.version}</version>
        </dependency>
        <!-- Compiled against the oldest supported line (Spring Boot 3.0). Provided, so that the
             application's own OpenTelemetry version is used and none is imposed on it -->
        <dependency>
            <groupId>io.opentelemetry</groupId>
            <artifactId>opentelemetry-api</artifactId>
            <version>${opentelemetry.version}</version>
            <scope>provided</scope>
        </dependency>
        <dependency>
            <groupId>io.opentelemetry</groupId>
            <artifactId>opentelemetry-sdk-testing</artifactId>
            <version>${opentelemetry.version}</version>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter</artifactId>
            <version>${junit.version}</version>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <artifactId>maven-jar-plugin</artifactId>
                <configuration>
                    <archive>
                        <manifest>
                            <addDefaultImplementationEntries>true</addDefaultImplementationEntries>
                        </manifest>
                        <manifestEntries>
                            <Automatic-Module-Name>io.github.authzenenforcer.opentelemetry</Automatic-Module-Name>
                        </manifestEntries>
                    </archive>
                </configuration>
            </plugin>
        </plugins>
    </build>
</project>
