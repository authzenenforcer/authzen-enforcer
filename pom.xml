<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <groupId>io.github.authzenenforcer</groupId>
    <artifactId>authzen-enforcer-parent</artifactId>
    <version>0.3.0-SNAPSHOT</version>
    <packaging>pom</packaging>

    <name>AuthZEN Enforcer Parent</name>
    <description>Java SDK acting as a Policy Enforcement Point (PEP) for the OpenID AuthZEN Authorization API.</description>
    <url>https://github.com/authzenenforcer/authzen-enforcer</url>
    <inceptionYear>2026</inceptionYear>

    <licenses>
        <license>
            <name>Apache License, Version 2.0</name>
            <url>https://www.apache.org/licenses/LICENSE-2.0.txt</url>
            <distribution>repo</distribution>
        </license>
    </licenses>

    <developers>
        <developer>
            <id>hakdogan</id>
            <name>Hüseyin Akdoğan</name>
            <email>hakdogan75@gmail.com</email>
            <url>https://github.com/hakdogan</url>
        </developer>
    </developers>

    <scm>
        <connection>scm:git:https://github.com/authzenenforcer/authzen-enforcer.git</connection>
        <developerConnection>scm:git:git@github.com:authzenenforcer/authzen-enforcer.git</developerConnection>
        <url>https://github.com/authzenenforcer/authzen-enforcer</url>
        <tag>HEAD</tag>
    </scm>

    <issueManagement>
        <system>GitHub Issues</system>
        <url>https://github.com/authzenenforcer/authzen-enforcer/issues</url>
    </issueManagement>

    <modules>
        <module>authzen-enforcer-bom</module>
        <module>authzen-enforcer-core</module>
        <module>authzen-enforcer-micrometer</module>
        <module>authzen-enforcer-opentelemetry</module>
        <module>authzen-enforcer-spring-boot-starter</module>
        <module>authzen-enforcer-interop-tests</module>
    </modules>

    <properties>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <project.reporting.outputEncoding>UTF-8</project.reporting.outputEncoding>
        <!-- Reproducible builds; updated by the release workflow -->
        <project.build.outputTimestamp>2026-11-12T11:02:39Z</project.build.outputTimestamp>

        <!-- Baseline for all modules -->
        <maven.compiler.release>17</maven.compiler.release>

        <!-- Optional integrations; the oldest supported line, kept on purpose -->
        <micrometer.version>1.10.13</micrometer.version>
        <opentelemetry.version>1.19.0</opentelemetry.version>
        <spring-boot.version>4.1.2</spring-boot.version>
        <!-- Test dependencies -->
        <junit.version>6.1.3</junit.version>
        <reactor.version>3.8.8</reactor.version>
        <mutiny.version>3.3.1</mutiny.version>
        <testcontainers.version>2.0.5</testcontainers.version>
        <!-- The SLF4J API line of Testcontainers; a 2.x binding would not bind to it -->
        <slf4j-simple.version>1.7.36</slf4j-simple.version>

        <!-- Plugins -->
        <maven-clean-plugin.version>3.5.0</maven-clean-plugin.version>
        <maven-resources-plugin.version>3.5.0</maven-resources-plugin.version>
        <maven-compiler-plugin.version>3.16.0</maven-compiler-plugin.version>
        <maven-surefire-plugin.version>3.6.1</maven-surefire-plugin.version>
        <maven-jar-plugin.version>3.5.1</maven-jar-plugin.version>
        <maven-install-plugin.version>3.2.0</maven-install-plugin.version>
        <maven-deploy-plugin.version>3.2.0</maven-deploy-plugin.version>
        <maven-enforcer-plugin.version>3.7.0</maven-enforcer-plugin.version>
        <maven-source-plugin.version>3.4.0</maven-source-plugin.version>
        <maven-javadoc-plugin.version>3.12.0</maven-javadoc-plugin.version>
        <maven-gpg-plugin.version>3.2.8</maven-gpg-plugin.version>
        <central-publishing-maven-plugin.version>0.12.0</central-publishing-maven-plugin.version>
        <versions-maven-plugin.version>2.24.0</versions-maven-plugin.version>
        <maven-site-plugin.version>3.22.0</maven-site-plugin.version>
        <maven-toolchains-plugin.version>3.3.0</maven-toolchains-plugin.version>
        <jacoco-maven-plugin.version>0.8.16</jacoco-maven-plugin.version>
        <sonar-maven-plugin.version>5.8.0.7211</sonar-maven-plugin.version>

        <!-- Code analysis: mvn verify sonar:sonar (server and token come from SONAR_HOST_URL / SONAR_TOKEN) -->
        <sonar.projectKey>authzenenforcer_authzen-enforcer</sonar.projectKey>
        <sonar.projectName>authzen-enforcer</sonar.projectName>
        <!-- Per-module reports, plus the aggregate that adds the interop tests' coverage of core -->
        <sonar.coverage.jacoco.xmlReportPaths>
            target/site/jacoco/jacoco.xml,
            ${maven.multiModuleProjectDirectory}/authzen-enforcer-interop-tests/target/site/jacoco-aggregate/jacoco.xml
        </sonar.coverage.jacoco.xmlReportPaths>
        <!-- Model types share their shape (Subject/Resource; the evaluation request types), so their
             accessors and builders repeat. A common base class would tie together types that the spec
             may evolve separately; duplicated logic belongs outside this package. -->
        <sonar.cpd.exclusions>**/io/github/authzenenforcer/core/model/**</sonar.cpd.exclusions>
    </properties>

    <build>
        <pluginManagement>
            <plugins>
                <plugin>
                    <artifactId>maven-clean-plugin</artifactId>
                    <version>${maven-clean-plugin.version}</version>
                </plugin>
                <plugin>
                    <artifactId>maven-resources-plugin</artifactId>
                    <version>${maven-resources-plugin.version}</version>
                </plugin>
                <plugin>
                    <artifactId>maven-compiler-plugin</artifactId>
                    <version>${maven-compiler-plugin.version}</version>
                    <configuration>
                        <compilerArgs>
                            <arg>-Xlint:all</arg>
                        </compilerArgs>
                    </configuration>
                </plugin>
                <plugin>
                    <artifactId>maven-surefire-plugin</artifactId>
                    <version>${maven-surefire-plugin.version}</version>
                </plugin>
                <plugin>
                    <artifactId>maven-jar-plugin</artifactId>
                    <version>${maven-jar-plugin.version}</version>
                </plugin>
                <plugin>
                    <artifactId>maven-install-plugin</artifactId>
                    <version>${maven-install-plugin.version}</version>
                </plugin>
                <plugin>
                    <artifactId>maven-deploy-plugin</artifactId>
                    <version>${maven-deploy-plugin.version}</version>
                </plugin>
                <plugin>
                    <artifactId>maven-enforcer-plugin</artifactId>
                    <version>${maven-enforcer-plugin.version}</version>
                </plugin>
                <plugin>
                    <artifactId>maven-source-plugin</artifactId>
                    <version>${maven-source-plugin.version}</version>
                </plugin>
                <plugin>
                    <artifactId>maven-javadoc-plugin</artifactId>
                    <version>${maven-javadoc-plugin.version}</version>
                </plugin>
                <plugin>
                    <artifactId>maven-gpg-plugin</artifactId>
                    <version>${maven-gpg-plugin.version}</version>
                </plugin>
                <plugin>
                    <artifactId>maven-site-plugin</artifactId>
                    <version>${maven-site-plugin.version}</version>
                </plugin>
                <plugin>
                    <groupId>org.codehaus.mojo</groupId>
                    <artifactId>versions-maven-plugin</artifactId>
                    <version>${versions-maven-plugin.version}</version>
                </plugin>
                <plugin>
                    <groupId>org.jacoco</groupId>
                    <artifactId>jacoco-maven-plugin</artifactId>
                    <version>${jacoco-maven-plugin.version}</version>
                </plugin>
                <plugin>
                    <groupId>org.sonarsource.scanner.maven</groupId>
                    <artifactId>sonar-maven-plugin</artifactId>
                    <version>${sonar-maven-plugin.version}</version>
                </plugin>
                <!-- Activated by the jdkNN profiles; they set toolchain.jdk.version -->
                <plugin>
                    <artifactId>maven-toolchains-plugin</artifactId>
                    <version>${maven-toolchains-plugin.version}</version>
                    <executions>
                        <execution>
                            <id>select-jdk</id>
                            <goals>
                                <goal>select-jdk-toolchain</goal>
                            </goals>
                            <configuration>
                                <version>${toolchain.jdk.version}</version>
                            </configuration>
                        </execution>
                    </executions>
                </plugin>
            </plugins>
        </pluginManagement>

        <plugins>
            <plugin>
                <artifactId>maven-enforcer-plugin</artifactId>
                <executions>
                    <execution>
                        <id>enforce-build-environment</id>
                        <goals>
                            <goal>enforce</goal>
                        </goals>
                        <configuration>
                            <rules>
                                <requireMavenVersion>
                                    <version>[3.9,)</version>
                                </requireMavenVersion>
                                <requireJavaVersion>
                                    <version>[17,)</version>
                                </requireJavaVersion>
                                <requirePluginVersions/>
                                <dependencyConvergence/>
                                <banDuplicatePomDependencyVersions/>
                            </rules>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
            <plugin>
                <groupId>org.jacoco</groupId>
                <artifactId>jacoco-maven-plugin</artifactId>
                <executions>
                    <execution>
                        <id>prepare-agent</id>
                        <goals>
                            <goal>prepare-agent</goal>
                        </goals>
                    </execution>
                    <execution>
                        <id>report</id>
                        <goals>
                            <goal>report</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>

    <profiles>
        <!--
          Compile and test with a specific JDK, whatever JDK runs Maven: mvn -P jdk21 verify
          The bytecode still targets Java 17 (maven.compiler.release). Installed JDKs are discovered
          automatically; see CONTRIBUTING.md.
        -->
        <profile>
            <id>jdk17</id>
            <properties>
                <toolchain.jdk.version>[17,18)</toolchain.jdk.version>
            </properties>
            <build>
                <plugins>
                    <plugin>
                        <artifactId>maven-toolchains-plugin</artifactId>
                    </plugin>
                </plugins>
            </build>
        </profile>
        <profile>
            <id>jdk21</id>
            <properties>
                <toolchain.jdk.version>[21,22)</toolchain.jdk.version>
            </properties>
            <build>
                <plugins>
                    <plugin>
                        <artifactId>maven-toolchains-plugin</artifactId>
                    </plugin>
                </plugins>
            </build>
        </profile>
        <profile>
            <id>jdk25</id>
            <properties>
                <toolchain.jdk.version>[25,26)</toolchain.jdk.version>
            </properties>
            <build>
                <plugins>
                    <plugin>
                        <artifactId>maven-toolchains-plugin</artifactId>
                    </plugin>
                </plugins>
            </build>
        </profile>

        <!-- Maven Central publishing: mvn -P release deploy -->
        <profile>
            <id>release</id>
            <build>
                <plugins>
                    <plugin>
                        <artifactId>maven-source-plugin</artifactId>
                        <executions>
                            <execution>
                                <id>attach-sources</id>
                                <goals>
                                    <goal>jar-no-fork</goal>
                                </goals>
                            </execution>
                        </executions>
                    </plugin>
                    <plugin>
                        <artifactId>maven-javadoc-plugin</artifactId>
                        <configuration>
                            <release>${maven.compiler.release}</release>
                            <doclint>all,-missing</doclint>
                            <!-- Internal packages are not part of the public API -->
                            <excludePackageNames>*.internal:*.internal.*</excludePackageNames>
                        </configuration>
                        <executions>
                            <execution>
                                <id>attach-javadocs</id>
                                <goals>
                                    <goal>jar</goal>
                                </goals>
                            </execution>
                        </executions>
                    </plugin>
                    <plugin>
                        <artifactId>maven-gpg-plugin</artifactId>
                        <configuration>
                            <bestPractices>true</bestPractices>
                        </configuration>
                        <executions>
                            <execution>
                                <id>sign-artifacts</id>
                                <phase>verify</phase>
                                <goals>
                                    <goal>sign</goal>
                                </goals>
                            </execution>
                        </executions>
                    </plugin>
                    <plugin>
                        <groupId>org.sonatype.central</groupId>
                        <artifactId>central-publishing-maven-plugin</artifactId>
                        <version>${central-publishing-maven-plugin.version}</version>
                        <extensions>true</extensions>
                        <configuration>
                            <publishingServerId>central</publishingServerId>
                            <!-- Review the deployment in the Central Portal before publishing -->
                            <autoPublish>false</autoPublish>
                            <waitUntil>validated</waitUntil>
                            <excludeArtifacts>
                                <excludeArtifact>authzen-enforcer-interop-tests</excludeArtifact>
                            </excludeArtifacts>
                        </configuration>
                    </plugin>
                </plugins>
            </build>
        </profile>
    </profiles>
</project>
